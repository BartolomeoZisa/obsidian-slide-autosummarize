{
	"name": "obsidian-slide-autosummarize",
	"version": "0.1.1",
	"description": "Obsidian plugin: auto-summarize PDF slides to Markdown with LLMs (Gemini first, modular providers incl. Ollama)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs"
	},
	"type": "module",
	"keywords": [
		"obsidian",
		"pdf",
		"summarize",
		"llm",
		"gemini",
		"ollama"
	],
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.28.2",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"pdfjs-dist": "^4.2.67"
	}
}
